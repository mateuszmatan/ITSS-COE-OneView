String given(String name) {
    return ((params[name] ?: '') as String).trim()
}

List toolVariables() {
    List names = [['CI_JAVA_HOME', 'ONEVIEW_CI_JAVA_HOME'], ['CI_NODE_HOME', 'ONEVIEW_CI_NODE_HOME'],
                  ['CI_BROWSER', 'ONEVIEW_CI_BROWSER'], ['CI_PERFORMANCE_FACTOR', 'ONEVIEW_CI_PERFORMANCE_FACTOR'],
                  ['CI_PIP_INDEX_URL', 'PIP_INDEX_URL']]
    List out = []
    for (int i = 0; i < names.size(); i++) {
        String value = given(names[i][0] as String)
        if (value) out << "${names[i][1]}=${value}".toString()
    }
    return out
}

Map origin() {
    return [url: scm.userRemoteConfigs[0].url, credentialsId: scm.userRemoteConfigs[0].credentialsId]
}

Map libraryRemote() {
    String url = given('CI_LIBRARY_REPOSITORY')
    if (!url) {
        url = (origin().url as String).replaceFirst('[^/]+$', 'dsoenhanced.git')
        echo "[CI] CI_LIBRARY_REPOSITORY is empty: DSOEnhanced is read from ${url}"
    }
    return [url: url, credentialsId: origin().credentialsId]
}

void checkoutBranch(String folder, Map remote, String branch) {
    dir(folder) {
        checkout([$class: 'GitSCM', branches: [[name: "refs/heads/${branch}"]], userRemoteConfigs: [remote],
                  extensions: [[$class: 'CloneOption', shallow: true, depth: 1, noTags: true]]])
    }
}

pipeline {
    agent { label "${params.CI_AGENT ?: (env.ONEVIEW_CI_AGENT ?: 'linux-agent')}" }
    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }
    triggers {
        cron(env.BRANCH_NAME == 'main' ? 'H 3 * * *' : '')
    }
    parameters {
        string(name: 'CI_AGENT', defaultValue: '', description: 'Agent label; empty: ONEVIEW_CI_AGENT, then linux-agent')
        string(name: 'CI_JAVA_HOME', defaultValue: '', description: 'A JDK 21 on the agent (ONEVIEW_CI_JAVA_HOME); empty: JAVA_HOME, then java on the PATH')
        string(name: 'CI_NODE_HOME', defaultValue: '', description: 'A Node.js folder with bin/node and bin/npm (ONEVIEW_CI_NODE_HOME); empty: node and npm on the PATH')
        string(name: 'CI_BROWSER', defaultValue: '', description: 'Chromium or Chrome of the agent for the browser suites (ONEVIEW_CI_BROWSER); empty: Playwright downloads its Chromium')
        string(name: 'CI_PERFORMANCE_FACTOR', defaultValue: '', description: 'Widens the time limits of the performance suite (ONEVIEW_CI_PERFORMANCE_FACTOR); empty: 2')
        string(name: 'CI_PIP_INDEX_URL', defaultValue: '', description: 'Python package index for the markdown module (PIP_INDEX_URL)')
        choice(name: 'CI_SHARED_FILES', choices: ['warn', 'fail', 'skip'], description: 'Shared files that differ: the build is UNSTABLE (warn), FAILURE (fail) or they are not compared (skip)')
        string(name: 'CI_LIBRARY_REPOSITORY', defaultValue: '', description: 'Clone address of DSOEnhanced; empty: dsoenhanced.git next to this repository')
    }
    stages {
        stage('Workspace') {
            steps {
                sh 'git clean -ffdx -q && mkdir -p build/ci/junit'
            }
        }
        stage('Tools') {
            steps {
                withEnv(toolVariables()) {
                    sh 'bash ci/prepare.sh'
                }
            }
        }
        stage('Build and tests') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    withEnv(toolVariables()) {
                        sh 'bash ci/build.sh'
                    }
                }
            }
        }
        stage('Shared files') {
            when {
                expression { (params.CI_SHARED_FILES ?: 'warn') != 'skip' }
            }
            steps {
                script {
                    String result = params.CI_SHARED_FILES == 'fail' ? 'FAILURE' : 'UNSTABLE'
                    catchError(buildResult: result, stageResult: result) {
                        Map library = libraryRemote()
                        checkoutBranch('build/ci/sources/without-portal', library, 'DSOEnhancedWithoutPortal')
                        checkoutBranch('build/ci/sources/main', library, 'main')
                        sh 'bash ci/shared-files.sh build/ci/sources/without-portal build/ci/sources/main'
                    }
                }
            }
        }
    }
    post {
        always {
            junit(testResults: 'backend/build/test-results/**/*.xml, frontend/build/test-results/**/*.xml, build/ci/junit/*.xml', allowEmptyResults: true)
            archiveArtifacts(artifacts: 'build/ci/*.log, build/ci/*.diff, build/ci/junit/*.xml, backend/build/reports/**, frontend/build/reports/**, frontend/coverage/**',
                             excludes: 'build/ci/sources/**', allowEmptyArchive: true)
        }
    }
}
